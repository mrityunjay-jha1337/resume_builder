        1,
        1
      ],
      "crop": null
    },
    {
      "id": "W6VLI3DstCPzOLG-Rzt2s",
      "type": "text",
      "x": 5111.615258216309,
      "y": 11248.104017146608,
      "width": 2842.8548994383054,
      "height": 1500.9091186523433,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4F",
      "roundness": null,
      "seed": 622249656,
      "version": 1394,
      "versionNonce": 792807112,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783929723246,
      "link": null,
      "locked": false,
      "text": "now on to the server side \nthe client can use rest api to do crud operations\nand also send the sam for path amtching\n\nthe backend picks up the path from the database by filtering on the\nbasis of time value and maximum delta \nthe paginated paths then are run on the sam \ngot from the client \nand the common path number and all meta data are sent to the client back.\n\nthe optimization here are to put minimum load on the server and do most of the things\non the client side\n\nthe suffix automaton heavily solves the problem of path matching \nalso the integer mapping of the station names optimizes the\nsam nodes and saves space \n\n",
      "fontSize": 66.7070719401042,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "now on to the server side \nthe client can use rest api to do crud operations\nand also send the sam for path amtching\n\nthe backend picks up the path from the database by filtering on the\nbasis of time value and maximum delta \nthe paginated paths then are run on the sam \ngot from the client \nand the common path number and all meta data are sent to the client back.\n\nthe optimization here are to put minimum load on the server and do most of the things\non the client side\n\nthe suffix automaton heavily solves the problem of path matching \nalso the integer mapping of the station names optimizes the\nsam nodes and saves space \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
