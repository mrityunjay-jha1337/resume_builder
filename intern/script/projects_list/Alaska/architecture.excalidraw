    {
      "id": "8_NCXBrVdBDUz67DkrCiH",
      "type": "text",
      "x": 1871.632084029451,
      "y": 11352.194592756307,
      "width": 2748.1284659404855,
      "height": 955.0798027002561,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4D",
      "roundness": null,
      "seed": 739939512,
      "version": 895,
      "versionNonce": 353943752,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783929703075,
      "link": null,
      "locked": false,
      "text": "this path on the frontend is converted into a list of integers on the client side \nthe mapping is hardcoded on the client side itself \nso that server wont need to unecessarily process this information\n\nthe integer array is then converted into a suffix automaton \na data structure that is optimized to store all the substrings of a string\nin o(n) space complexity\nfor example \nthe suffix automaton for a string \"abcabc\" looks like this\n\n",
      "fontSize": 69.46034928729138,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this path on the frontend is converted into a list of integers on the client side \nthe mapping is hardcoded on the client side itself \nso that server wont need to unecessarily process this information\n\nthe integer array is then converted into a suffix automaton \na data structure that is optimized to store all the substrings of a string\nin o(n) space complexity\nfor example \nthe suffix automaton for a string \"abcabc\" looks like this\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KuDH0EZHH3NvFEdtY3wSI",
      "type": "image",
      "x": 5386.900644679048,
      "y": 9969.3138637292,
      "width": 1733.3756247065041,
      "height": 1140.087415994699,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4E",
      "roundness": null,
      "seed": 1180122552,
      "version": 840,
      "versionNonce": 1343992264,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783929718275,
