# Chat Gateway Environment Variables (Dummy/Example)

# Port for the Gateway WebSocket server
PORT=4001

# URL to the Chat Worker API
WORKER_URL="http://localhost:4002"

# Redis Connection URL (for Pub/Sub and Socket.IO adapter)
REDIS_URL="redis://localhost:6379"

# Secret Key to authenticate requests sent to the Chat Worker
INTERNAL_API_KEY="your_super_secret_internal_key"
