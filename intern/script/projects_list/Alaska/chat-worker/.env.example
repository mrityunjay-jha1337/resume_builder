# Chat Worker Environment Variables (Dummy/Example)

# Port for the Worker
PORT=4002

# MongoDB Connection String (for saving chat history)
MONGO_URI="mongodb://localhost:27017/alaska-chat"

# Redis Connection URL (for Pub/Sub to communicate with Gateway)
REDIS_URL="redis://localhost:6379"

# Secret Key to authenticate requests received from the Gateway
INTERNAL_API_KEY="your_super_secret_internal_key"
