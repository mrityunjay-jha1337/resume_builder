# Backend Environment Variables (Dummy/Example)

# Port for the server
PORT=3000

# Node Environment
NODE_ENV=development

# Postgres Database URL (Change password and db name as needed)
DATABASE_URL="postgresql://postgres:password@localhost:5432/alaska?schema=public"

# JWT Secret for Auth
JWT_SECRET="your_super_secret_jwt_key_here"

# Cloudinary (If used)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
